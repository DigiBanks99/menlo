@inherits MnlComponent
@*
    A button, or a link that looks like one when Href is set.
    For server actions put hx-* attributes on it: they land on the root element.
    While an htmx request from the button (or from the form it submits) is in flight, it shows a spinner.
*@
@if (Href is not null)
{
    <a @attributes="Attributes"
       class="@RootClass("mnl-button")"
       href="@(Disabled ? null : Href)"
       data-variant="@Css.Token(Variant)"
       data-size="@Css.Token(Size)"
       data-full-width="@Css.Flag(FullWidth)"
       aria-disabled="@Css.Flag(Disabled)">@Content</a>
}
else
{
    <button @attributes="Attributes"
            class="@RootClass("mnl-button")"
            type="@Css.Token(Type)"
            disabled="@Disabled"
            data-variant="@Css.Token(Variant)"
            data-size="@Css.Token(Size)"
            data-full-width="@Css.Flag(FullWidth)">@Content</button>
}

@code {
    /// <summary>The button's emphasis.</summary>
    [Parameter]
    public MnlButtonVariant Variant { get; set; } = MnlButtonVariant.Primary;

    /// <summary>The button's size.</summary>
    [Parameter]
    public MnlSize Size { get; set; } = MnlSize.Md;

    /// <summary>The HTML button type. Ignored when Href is set.</summary>
    [Parameter]
    public MnlButtonType Type { get; set; } = MnlButtonType.Button;

    /// <summary>When set, the component renders a link styled as a button. Use it for navigation.</summary>
    [Parameter]
    public string? Href { get; set; }

    /// <summary>Whether the button is unavailable.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Whether the button fills its container's width.</summary>
    [Parameter]
    public bool FullWidth { get; set; }

    /// <summary>An icon shown before the label.</summary>
    [Parameter]
    public MnlIconName? Icon { get; set; }

    /// <summary>The label.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private RenderFragment Content => @<text>
        <span class="mnl-button__spinner" aria-hidden="true"></span>
        @if (Icon is not null)
        {
            <MnlIcon Name="Icon.Value" Size="MnlSize.Sm" class="mnl-button__icon" />
        }
        <span class="mnl-button__label">@ChildContent</span>
    </text>;
}
