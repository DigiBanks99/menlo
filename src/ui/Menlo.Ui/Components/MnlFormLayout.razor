@inherits MnlComponent
@*
    The frame of a form: an optional title block, the fields, and a row of actions at the end.
    Put it inside the <form>. Group fields with MnlGrid or MnlStack.
*@
<div @attributes="Attributes" class="@RootClass("mnl-form-layout")">
    @if (Title is not null)
    {
        <div class="mnl-form-layout__title">@Title</div>
    }
    <div class="mnl-form-layout__sections">@ChildContent</div>
    @if (Actions is not null)
    {
        <div class="mnl-form-layout__actions">@Actions</div>
    }
</div>

@code {
    /// <summary>A heading and description for the form.</summary>
    [Parameter]
    public RenderFragment? Title { get; set; }

    /// <summary>The fields.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The buttons: cancel first, the primary action last.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }
}
