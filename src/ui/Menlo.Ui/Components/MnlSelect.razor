@inherits MnlComponent
@*
    A native dropdown. Placeholder adds an empty first choice, so "nothing selected" can be submitted.
*@
<select @attributes="Attributes"
        class="@RootClass("mnl-select")"
        id="@(Id ?? Name)"
        name="@Name"
        required="@Required"
        disabled="@Disabled"
        aria-invalid="@Css.Flag(Invalid)"
        aria-describedby="@(Invalid ? $"{Id ?? Name}-error" : null)">
    @if (Placeholder is not null)
    {
        <option value="" selected="@string.IsNullOrEmpty(Value)">@Placeholder</option>
    }
    @foreach (MnlOption option in Options)
    {
        <option value="@option.Value" selected="@(option.Value == Value)">@option.Label</option>
    }
</select>

@code {
    /// <summary>The form field name.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>The element id. Defaults to Name.</summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>The selected value.</summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>The choices.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<MnlOption> Options { get; set; } = [];

    /// <summary>The label of an empty first choice. Null leaves it out.</summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>Whether the browser requires a choice.</summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>Whether the select is unavailable.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Whether the value failed validation.</summary>
    [Parameter]
    public bool Invalid { get; set; }
}
