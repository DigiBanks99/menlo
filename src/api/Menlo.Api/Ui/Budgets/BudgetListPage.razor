@* Every budget of the household, newest first, with this month's spending. *@
<AppPage Page="Page" Title="Budgets">
    <MnlStack Gap="MnlGap.Xl" data-testid="budget-list-page">
        <MnlPageHeader>
            <Hero>
                <MnlStack Gap="MnlGap.Lg" Align="MnlAlign.Start" data-testid="budget-list-hero">
                    <MnlBadge Size="MnlSize.Sm">Household budgets</MnlBadge>
                    <MnlStack Gap="MnlGap.Sm">
                        <MnlHeading Level="1">Budget Management</MnlHeading>
                        <MnlText Size="MnlTextSize.Lg" Tone="MnlTextTone.Inherit">Track and manage your family budgets with AI-powered insights.</MnlText>
                    </MnlStack>
                    @if (Model.CanEdit && Model.Budgets.Count > 0 && Model.NextBudgetYear is { } year)
                    {
                        <form method="post" action="@($"/budgets/{year}")" data-testid="budget-list-actions">
                            <MnlButton Type="MnlButtonType.Submit" data-testid="create-budget-button">Create @year Budget</MnlButton>
                        </form>
                    }
                </MnlStack>
            </Hero>
        </MnlPageHeader>

        <MnlStack Gap="MnlGap.Lg" data-testid="budget-list-section">
            @if (Model.CreateError is not null)
            {
                <MnlAlert Tone="MnlTone.Error" data-testid="create-budget-error">@Model.CreateError</MnlAlert>
            }

            @if (Model.LoadError is not null)
            {
                <MnlAlert Tone="MnlTone.Error" Title="We couldn't load your budgets." data-testid="budget-list-error">@Model.LoadError</MnlAlert>
            }
            else if (Model.Budgets.Count > 0)
            {
                <MnlGrid Columns="MnlGridColumns.Three">
                    @foreach (BudgetCardModel budget in Model.Budgets)
                    {
                        <MnlCard Interactive="true" data-testid="@($"budget-card-{budget.Id}")">
                            <Header>
                                <MnlCluster Justify="MnlJustify.Between" Align="MnlAlign.Start">
                                    <MnlStack Gap="MnlGap.Xs">
                                        <MnlHeading Level="2" Size="MnlTextSize.Xl">Budget @budget.Year</MnlHeading>
                                        <MnlText Tone="MnlTextTone.Subtle">@budget.CategoryCount</MnlText>
                                    </MnlStack>
                                    <MnlBadge Tone="budget.StatusTone" Size="MnlSize.Sm" data-testid="@($"budget-status-{budget.Id}")">@budget.Status</MnlBadge>
                                </MnlCluster>
                            </Header>
                            <ChildContent>
                                <MnlStack Gap="MnlGap.Sm">
                                    <MnlProgress Value="budget.SpentPercent"
                                                 Tone="budget.SpendTone"
                                                 AriaLabel="@($"Budget {budget.Year} spending this month")"
                                                 data-testid="@($"budget-progress-{budget.Id}")" />
                                    <MnlCluster Justify="MnlJustify.Between" data-testid="@($"budget-spend-{budget.Id}")">
                                        <MnlText Tone="MnlTextTone.Subtle" Inline="true">@budget.SpendText</MnlText>
                                        <MnlText Weight="MnlWeight.Semibold" Inline="true">@budget.PercentText</MnlText>
                                    </MnlCluster>
                                </MnlStack>
                            </ChildContent>
                            <Footer>
                                <MnlCluster Justify="MnlJustify.End">
                                    <MnlButton Href="@($"/budgets/{budget.Id}")" Size="MnlSize.Sm" data-testid="@($"budget-view-{budget.Id}")">View Details</MnlButton>
                                </MnlCluster>
                            </Footer>
                        </MnlCard>
                    }
                </MnlGrid>
            }
            else
            {
                <MnlCard Padding="MnlSize.Lg" data-testid="budget-list-empty-state">
                    <MnlEmptyState Title="No budgets yet" Message="Create your first budget to start tracking your family's finances.">
                        @if (Model.CanEdit && Model.NextBudgetYear is { } year)
                        {
                            <form method="post" action="@($"/budgets/{year}")">
                                <MnlButton Type="MnlButtonType.Submit" data-testid="empty-create-budget-button">Create Your First Budget</MnlButton>
                            </form>
                        }
                    </MnlEmptyState>
                </MnlCard>
            }
        </MnlStack>
    </MnlStack>
</AppPage>

@code {
    [Parameter, EditorRequired]
    public PageContext Page { get; set; } = null!;

    [Parameter, EditorRequired]
    public BudgetListPageModel Model { get; set; } = null!;
}
