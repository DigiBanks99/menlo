@*
    One budget: its total, the category tree, the items of the open leaf category, and the summary.
    Everything inside the region reloads together when the state in the URL or the data changes
    (see BudgetRegion), so the parts can never disagree.
*@
<AppPage Page="Page" Title="@($"{Model.Year} Budget")">
    <div id="@BudgetRegion.Id" @attributes="BudgetRegion.ReloadOnChange()">
        <MnlStack Gap="MnlGap.Lg">
            <MnlPageHeader>
                <Hero>
                    <MnlCluster Justify="MnlJustify.Between" Align="MnlAlign.Start">
                        <MnlStack Gap="MnlGap.Sm">
                            <MnlEyebrow Tone="MnlTextTone.Inherit">Budget detail</MnlEyebrow>
                            <MnlHeading Level="1" data-testid="budget-year">@Model.Year Budget</MnlHeading>
                            <MnlText Tone="MnlTextTone.Inherit">
                                Manage categories, line items, and year-over-year continuation from a single responsive workspace.
                            </MnlText>
                        </MnlStack>
                        <MnlBadge Tone="Model.StatusTone" data-testid="status-badge">@Model.Status</MnlBadge>
                    </MnlCluster>
                </Hero>
                <ChildContent>
                    <MnlCard Padding="MnlSize.Lg">
                        <MnlSplit Ratio="MnlSplitRatio.AutoEnd" Align="MnlAlign.Center" Gap="MnlGap.Md">
                            <MnlStack Gap="MnlGap.Sm">
                                <MnlEyebrow Tone="MnlTextTone.Subtle">Total planned monthly</MnlEyebrow>
                                <MnlText Size="MnlTextSize.Xxxl" Weight="MnlWeight.Bold" Numeric="true" data-testid="total-amount">@Model.TotalPlanned</MnlText>
                                <MnlText Tone="MnlTextTone.Subtle">Review category allocations below and open a leaf category to manage its items.</MnlText>
                            </MnlStack>
                            <div>
                                @if (Model.CanEdit && Model.NextYearToCreate is { } year)
                                {
                                    <form method="post" action="@($"/budgets/{year}")">
                                        <MnlButton Type="MnlButtonType.Submit" data-testid="create-next-year-btn">Create @year Budget</MnlButton>
                                    </form>
                                }
                            </div>
                        </MnlSplit>
                    </MnlCard>
                </ChildContent>
            </MnlPageHeader>

            <MnlSplit Ratio="MnlSplitRatio.WideStart">
                <MnlStack Gap="MnlGap.Lg">
                    <MnlCard Padding="MnlSize.Lg">
                        <Header>
                            <MnlStack Gap="MnlGap.Xs">
                                <MnlHeading Level="2" Size="MnlTextSize.Xl">Category management</MnlHeading>
                                <MnlText Tone="MnlTextTone.Subtle">Maintain the budget tree and choose a leaf category to work on its items.</MnlText>
                            </MnlStack>
                        </Header>
                        <ChildContent>
                            <div data-testid="category-tree-section">
                                <CategoryTree Model="Model.Tree" />
                            </div>
                        </ChildContent>
                    </MnlCard>

                    <MnlCard Padding="MnlSize.Lg">
                        <Header>
                            <MnlStack Gap="MnlGap.Xs">
                                <MnlHeading Level="2" Size="MnlTextSize.Xl">Leaf category items</MnlHeading>
                                <MnlText Tone="MnlTextTone.Subtle">Select a leaf category to open its line-item workspace.</MnlText>
                            </MnlStack>
                        </Header>
                        <ChildContent>
                            <LeafCategories Model="Model.Leaves" />
                        </ChildContent>
                    </MnlCard>

                    @if (Model.Workspace is not null)
                    {
                        <section data-testid="items-workspace-section">
                            <ItemsWorkspace Model="Model.Workspace" />
                        </section>
                    }
                </MnlStack>

                <section data-testid="budget-summary-section">
                    <MnlCard Padding="MnlSize.Lg">
                        <Header>
                            <MnlStack Gap="MnlGap.Xs">
                                <MnlHeading Level="2" Size="MnlTextSize.Xl">Summary</MnlHeading>
                                <MnlText Tone="MnlTextTone.Subtle">Explore yearly or monthly rollups for the selected budget.</MnlText>
                            </MnlStack>
                        </Header>
                        <ChildContent>
                            <BudgetSummary Model="Model.Summary" />
                        </ChildContent>
                    </MnlCard>
                </section>
            </MnlSplit>
        </MnlStack>
    </div>
</AppPage>

@code {
    [Parameter, EditorRequired]
    public PageContext Page { get; set; } = null!;

    [Parameter, EditorRequired]
    public BudgetDetailPageModel Model { get; set; } = null!;
}
