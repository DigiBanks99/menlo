@* Asks before deleting a budget item. If the delete fails, the panel comes back with the reason. *@
<MnlPanel Mode="MnlPanelMode.Dialog" data-testid="delete-confirmation-panel">
    <Header>
        <MnlStack Gap="MnlGap.Xs">
            <MnlHeading Level="3">Delete budget item?</MnlHeading>
            <MnlText Tone="MnlTextTone.Subtle">This can't be undone from the workspace.</MnlText>
        </MnlStack>
    </Header>
    <ChildContent>
        <MnlStack>
            @if (Model.Error is not null)
            {
                <MnlAlert Tone="MnlTone.Error" data-testid="delete-error">@Model.Error</MnlAlert>
            }
            <MnlCluster Justify="MnlJustify.End" Gap="MnlGap.Md">
                <MnlButton Variant="MnlButtonVariant.Ghost" data-mnl-close data-testid="btn-confirm-no">No</MnlButton>
                <MnlButton Variant="MnlButtonVariant.Destructive"
                           hx-delete="@Model.Action"
                           hx-target="closest dialog"
                           hx-swap="outerHTML"
                           data-testid="btn-confirm-yes">Yes, delete</MnlButton>
            </MnlCluster>
        </MnlStack>
    </ChildContent>
</MnlPanel>

@code {
    [Parameter, EditorRequired]
    public DeleteItemModel Model { get; set; } = null!;
}
