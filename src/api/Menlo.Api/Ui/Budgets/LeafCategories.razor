@*
    Every category in tree order, indented by depth. A leaf has a button that opens its items
    (or closes them when they are open). Depth is shown with a class per level, because the
    Content Security Policy doesn't allow inline styles.
*@
<ul class="leaf-categories">
    @foreach (LeafRowModel row in Model.Rows)
    {
        <li data-depth="@Math.Min(row.Depth, 6)" data-testid="@($"category-{row.Id}")">
            <MnlListItem Selected="row.IsSelected">
                <ChildContent>
                    <MnlCluster>
                        <MnlText Weight="MnlWeight.Semibold" Inline="true">@row.Name</MnlText>
                        @if (row.IsDeep)
                        {
                            <MnlTag Tone="MnlTone.Warning" title="Consider flattening this category structure" data-testid="depth-warning">Deep branch</MnlTag>
                        }
                    </MnlCluster>
                    <MnlText Size="MnlTextSize.Xs" Tone="MnlTextTone.Subtle">
                        Depth @row.Depth · @(row.IsLeaf ? "Leaf category" : "Parent category")
                    </MnlText>
                </ChildContent>
                <Trailing>
                    @if (row.IsLeaf)
                    {
                        <MnlButton Href="@row.ToggleUrl"
                                   Size="MnlSize.Sm"
                                   Variant="@(row.IsSelected ? MnlButtonVariant.Secondary : MnlButtonVariant.Ghost)"
                                   @attributes="BudgetRegion.GoTo(row.ToggleUrl)"
                                   data-testid="@($"btn-view-items-{row.Id}")">@(row.IsSelected ? "Close items" : "View items")</MnlButton>
                    }
                </Trailing>
            </MnlListItem>
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired]
    public LeafCategoriesModel Model { get; set; } = null!;
}
