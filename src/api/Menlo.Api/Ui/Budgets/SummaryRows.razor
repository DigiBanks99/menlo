@* The category lines of one summary section. A category with children expands to show them. *@
@if (Rows.Count == 0)
{
    <MnlText Tone="MnlTextTone.Subtle">Nothing here yet.</MnlText>
}
else
{
    <MnlStack Gap="MnlGap.Sm">
        @foreach (SummaryRowModel row in Rows)
        {
            @if (row.Children.Count > 0)
            {
                <MnlDisclosure Open="true" data-testid="@($"summary-row-{row.Key}")">
                    <Summary>
                        <SummaryRow Row="row" Strong="true" />
                    </Summary>
                    <ChildContent>
                        @foreach (SummaryRowModel child in row.Children)
                        {
                            <MnlDisclosure data-testid="@($"summary-row-{child.Key}")">
                                <Summary>
                                    <SummaryRow Row="child" />
                                </Summary>
                            </MnlDisclosure>
                        }
                    </ChildContent>
                </MnlDisclosure>
            }
            else
            {
                <MnlDisclosure data-testid="@($"summary-row-{row.Key}")">
                    <Summary>
                        <SummaryRow Row="row" Strong="true" />
                    </Summary>
                </MnlDisclosure>
            }
        }
    </MnlStack>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SummaryRowModel> Rows { get; set; } = [];

    [Parameter]
    public bool HasRealized { get; set; }

    [Parameter]
    public bool HasSpent { get; set; }
}
