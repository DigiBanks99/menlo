@* One line of the summary: a name and up to three right-aligned figures (planned, realized, spent). *@
<span class="summary-row">
    <MnlText Inline="true" Weight="@(Strong ? MnlWeight.Semibold : MnlWeight.Regular)" class="summary-row__name">@Row.Name</MnlText>
    <MnlText Inline="true" Numeric="true" Weight="@(Strong ? MnlWeight.Semibold : MnlWeight.Medium)" class="summary-row__figure" title="Planned" data-testid="summary-planned">@Row.Planned</MnlText>
    @if (Row.Realized is not null)
    {
        <MnlText Inline="true" Numeric="true" Weight="@(Strong ? MnlWeight.Semibold : MnlWeight.Medium)" class="summary-row__figure" title="Realized" data-testid="summary-realized">@Row.Realized</MnlText>
    }
    @if (Row.Spent is not null)
    {
        <MnlText Inline="true" Numeric="true" Weight="@(Strong ? MnlWeight.Semibold : MnlWeight.Medium)" class="summary-row__figure" title="Spent" data-testid="summary-spent">@Row.Spent</MnlText>
    }
</span>

@code {
    [Parameter, EditorRequired]
    public SummaryRowModel Row { get; set; } = null!;

    [Parameter]
    public bool Strong { get; set; }
}
