@* The one-amount form. It replaces itself with the server's answer when validation fails. *@
<form @attributes="SubmitAttributes" hx-target="this" hx-swap="outerHTML" data-testid="amount-form" novalidate>
    <MnlFormLayout>
        <ChildContent>
            <MnlFormField Label="@Model.Label" For="amount" Required="true" Error="@Model.Errors.For("amount")">
                <MnlAmountInput Name="amount" Value="Model.Amount" Invalid="@Model.Errors.Has("amount")" data-testid="input-amount" autofocus />
            </MnlFormField>
            @if (Model.Errors.Form is not null)
            {
                <MnlAlert Tone="MnlTone.Error" data-testid="error-message">@Model.Errors.Form</MnlAlert>
            }
        </ChildContent>
        <Actions>
            <MnlButton Variant="MnlButtonVariant.Ghost" data-mnl-close data-testid="btn-cancel">Cancel</MnlButton>
            <MnlButton Type="MnlButtonType.Submit" data-testid="btn-submit">@Model.SubmitLabel</MnlButton>
        </Actions>
    </MnlFormLayout>
</form>

@code {
    [Parameter, EditorRequired]
    public AmountFormModel Model { get; set; } = null!;

    private Dictionary<string, object> SubmitAttributes => new()
    {
        [$"hx-{Model.Method}"] = Model.Action
    };
}
