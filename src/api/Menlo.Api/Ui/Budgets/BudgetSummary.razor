@* Income, expenses and net for a month or the whole year. The period lives in the URL. *@
<MnlStack data-testid="budget-summary">
    <MnlSegmented Label="Summary period"
                  Segments="Model.Views"
                  Value="@Model.View"
                  hx-target="@($"#{BudgetRegion.Id}")"
                  hx-select="@($"#{BudgetRegion.Id}")"
                  hx-swap="outerHTML"
                  hx-replace-url="true"
                  data-testid="summary-views" />

    @if (Model.IsMonthly)
    {
        <nav class="summary-months" aria-label="Summary month">
            <MnlButton Href="@Model.PreviousMonthUrl"
                       Variant="MnlButtonVariant.Secondary"
                       Size="MnlSize.Sm"
                       Disabled="Model.PreviousMonthUrl is null"
                       @attributes="LinkTo(Model.PreviousMonthUrl)"
                       data-testid="summary-previous-month">← Previous Month</MnlButton>
            <MnlEyebrow Tone="MnlTextTone.Subtle" data-testid="summary-month">@Model.MonthLabel</MnlEyebrow>
            <MnlButton Href="@Model.NextMonthUrl"
                       Variant="MnlButtonVariant.Secondary"
                       Size="MnlSize.Sm"
                       Disabled="Model.NextMonthUrl is null"
                       @attributes="LinkTo(Model.NextMonthUrl)"
                       data-testid="summary-next-month">Next Month →</MnlButton>
        </nav>
    }

    @if (Model.Error is not null)
    {
        <MnlAlert Tone="MnlTone.Error" data-testid="summary-error">@Model.Error</MnlAlert>
    }
    else
    {
        <MnlStack Gap="MnlGap.Lg">
            <section data-testid="summary-income">
                <MnlStack Gap="MnlGap.Sm">
                    <MnlHeading Level="3" Size="MnlTextSize.Md">Income</MnlHeading>
                    <SummaryRows Rows="Model.Income" HasRealized="Model.HasRealized" HasSpent="Model.HasSpent" />
                </MnlStack>
            </section>
            <section data-testid="summary-expenses">
                <MnlStack Gap="MnlGap.Sm">
                    <MnlHeading Level="3" Size="MnlTextSize.Md">Expenses</MnlHeading>
                    <SummaryRows Rows="Model.Expenses" HasRealized="Model.HasRealized" HasSpent="Model.HasSpent" />
                </MnlStack>
            </section>
            @if (Model.Net is not null)
            {
                <section data-testid="summary-net">
                    <MnlStack Gap="MnlGap.Sm">
                        <MnlHeading Level="3" Size="MnlTextSize.Md">Net</MnlHeading>
                        <MnlListItem Selected="true">
                            <SummaryRow Row="Model.Net" Strong="true" />
                        </MnlListItem>
                    </MnlStack>
                </section>
            }
        </MnlStack>
    }
</MnlStack>

@code {
    [Parameter, EditorRequired]
    public BudgetSummaryModel Model { get; set; } = null!;

    private static Dictionary<string, object>? LinkTo(string? url) => url is null ? null : BudgetRegion.GoTo(url);
}
