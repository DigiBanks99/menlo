@*
    PROTOTYPE (#768): receipts (#770). Take 1 to 3 photos of one slip and send them; the list shows each receipt's
    status until a member checks it. The reading is simulated: pick what the "model" will read before sending.
*@
@using Menlo.Api.Ui.Budgets.Prototype.Plan
@{
    string root = PQuery.PayRoot;
    string back = PayLinks.Receipts(Model.Variant, Model.Budget);
}
<AppPage Page="Page" Title="Receipts">
    <link rel="stylesheet" href="/prototype/pay.css?v=4" />
    <div class="payquick">
        <MnlStack Gap="MnlGap.Lg">
            <MnlCluster Justify="MnlJustify.Between" Align="MnlAlign.Center">
                <MnlHeading Level="1">Receipts</MnlHeading>
                <MnlCluster Gap="MnlGap.Sm">
                    <PayAs SignedIn="@Model.SignedIn" Back="@back" />
                    <MnlButton Href="@Model.Budget" Variant="MnlButtonVariant.Secondary" Icon="MnlIconName.X" data-testid="close-receipts">Close</MnlButton>
                </MnlCluster>
            </MnlCluster>

            <MnlCard>
                <Header><span id="take">Take a photo of a slip</span></Header>
                <ChildContent>
                    <form method="post" action="@(root + "/receipts")" enctype="multipart/form-data" class="payreceipts__take" data-testid="take-receipt">
                        <input type="hidden" name="variant" value="@Model.Variant" />
                        <input type="hidden" name="budget" value="@Model.Budget" />
                        <label class="payreceipts__shoot">
                            <MnlIcon Name="MnlIconName.Camera" />
                            <span class="payreceipts__shoot-text"><strong>Camera or gallery</strong><span>Up to 3 photos, for a long slip.</span></span>
                            <input type="file" name="photos" accept="image/*" capture="environment" multiple />
                        </label>
                        <MnlFormField Label="Prototype only: what the model will read" For="scenario">
                            <MnlSelect Id="scenario" Name="scenario" Value="hardware" Options="ScenarioOptions" />
                        </MnlFormField>
                        <MnlButton Type="MnlButtonType.Submit" Icon="MnlIconName.Check">Send it</MnlButton>
                    </form>
                </ChildContent>
            </MnlCard>

            <PayReceiptList Model="Model" />

            <MnlCard>
                <Header>Prototype controls</Header>
                <ChildContent>
                    <MnlStack Gap="MnlGap.Sm">
                        <MnlCluster Gap="MnlGap.Sm">
                            <form method="post" action="@(root + "/settings")">
                                <input type="hidden" name="op" value="model" />
                                <input type="hidden" name="back" value="@back" />
                                <input type="hidden" name="up" value="@(PayStore.ModelUp ? "false" : "true")" />
                                <MnlButton Type="MnlButtonType.Submit" Variant="MnlButtonVariant.Secondary" Size="MnlSize.Sm">@ModelLabel</MnlButton>
                            </form>
                            <form method="post" action="@(root + "/settings")">
                                <input type="hidden" name="op" value="reset" />
                                <input type="hidden" name="back" value="@back" />
                                <MnlButton Type="MnlButtonType.Submit" Variant="MnlButtonVariant.Ghost" Size="MnlSize.Sm">Put the made-up data back</MnlButton>
                            </form>
                        </MnlCluster>
                        <MnlText Size="MnlTextSize.Sm" Tone="MnlTextTone.Subtle">@ModelText</MnlText>
                    </MnlStack>
                </ChildContent>
            </MnlCard>
        </MnlStack>
    </div>
    <PaySwitcher Variant="@Model.Variant" />
</AppPage>

@code {
    [Parameter, EditorRequired] public PageContext Page { get; set; } = null!;
    [Parameter, EditorRequired] public PayReceiptsModel Model { get; set; } = null!;

    private static IReadOnlyList<MnlOption> ScenarioOptions => [.. PayStore.Scenarios.Select(s => new MnlOption(s.Key, s.Label))];

    private static string ModelLabel => PayStore.ModelUp ? "Take the model server down" : "Bring the model server back";

    private static string ModelText => $"The model server is {(PayStore.ModelUp ? "up" : "down")}. A photo waits about 5 seconds, then is read for about 12, one receipt at a time.";
}
