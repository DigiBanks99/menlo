@* PROTOTYPE (#768): variant B's page for a line's or category's payments in a month. *@
<AppPage Page="Page" Title="@Model.Title">
    <link rel="stylesheet" href="/prototype/pay.css?v=3" />
    <div class="payquick">
        <MnlStack Gap="MnlGap.Lg">
            <MnlButton Href="@Model.Back" Variant="MnlButtonVariant.Ghost" Size="MnlSize.Sm">← Back to the budget</MnlButton>
            <MnlHeading Level="1">@Model.Title</MnlHeading>
            <PayMonthList Model="Model" />
        </MnlStack>
    </div>
    <PaySwitcher Variant="@Model.Variant" />
</AppPage>

@code {
    [Parameter, EditorRequired] public PageContext Page { get; set; } = null!;
    [Parameter, EditorRequired] public PayMonthModel Model { get; set; } = null!;
}
