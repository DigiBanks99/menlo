@*
    PROTOTYPE (#658): the year grid from the views prototype (#596), planned amounts only. Categories and
    their subcategories head their lines. Letters in a cell say which layers shape it. A proposal being worked
    on or switched on shows the old amount struck through. Variants A and B choose what a click opens.
*@
@{
    PQuery q = Sheet.Query;
    PYear plan = Sheet.Plan;
    PYear pv = Sheet.Preview;
}
<div class="pgrid-wrap" tabindex="0" role="region" aria-label="Plan grid" data-testid="plan-grid">
    <table class="pgrid">
        <thead>
            <tr>
                <th scope="col" class="pgrid__name">Category and line</th>
                @for (int i = 0; i < 12; i++)
                {
                    int m = i;
                    <th scope="col" data-month="@PFormat.State(plan, m)">
                        @PFormat.Month(m)
                        <span class="pgrid__state">@(m < plan.Current ? "frozen" : m == plan.Current ? "now" : "")</span>
                    </th>
                }
                <th scope="col" class="pgrid__total">Year</th>
            </tr>
        </thead>
        <tbody>
            @foreach (PCategory top in pv.Tops)
            {
                PCategory t = top;
                <tr class="pgrid__top">
                    <th scope="row" class="pgrid__name">
                        @t.Name
                        @CategoryEdit(t)
                    </th>
                    @Totals(pv.Children(t.Id).SelectMany(c => pv.Lines.Where(l => l.CategoryId == c.Id)))
                </tr>
                @if (CategoryBelow is not null && q.Edit == "cat:" + t.Id)
                {
                    <tr class="pgrid__editor"><td colspan="14"><div class="pgrid__editor-body">@CategoryBelow(t)</div></td></tr>
                }
                @foreach (PCategory child in pv.Children(t.Id))
                {
                    PCategory c = child;
                    List<PLine> lines = [.. pv.Lines.Where(l => l.CategoryId == c.Id)];
                    <tr class="pgrid__cat">
                        <th scope="row" class="pgrid__name">
                            <span class="pgrid__indent">@c.Name @if (lines.Count == 0) { <em>(no lines)</em> }</span>
                            @CategoryEdit(c)
                        </th>
                        @Totals(lines)
                    </tr>
                    @if (CategoryBelow is not null && q.Edit == "cat:" + c.Id)
                    {
                        <tr class="pgrid__editor"><td colspan="14"><div class="pgrid__editor-body">@CategoryBelow(c)</div></td></tr>
                    }
                    @foreach (PLine line in lines)
                    {
                        PLine l = line;
                        PLine? before = plan.Lines.FirstOrDefault(x => x.Id == l.Id);
                        <tr class="pgrid__line" data-selected="@(q.Line == l.Id ? "true" : null)">
                            <th scope="row" class="pgrid__name">
                                <span class="pgrid__indent pgrid__indent--2">
                                    @if (LineLinks)
                                    {
                                        <a href="@(q.Line == l.Id ? q.WithLine(null) : q.WithLine(l.Id))" aria-expanded="@(q.Line == l.Id ? "true" : "false")">@l.Name</a>
                                    }
                                    else
                                    {
                                        @l.Name
                                    }
                                    <span class="pgrid__type">@PFormat.Type(l.Type)</span>
                                    @if (before is null)
                                    {
                                        <MnlTag Tone="MnlTone.Accent">new in proposal</MnlTag>
                                    }
                                </span>
                            </th>
                            @for (int i = 0; i < 12; i++)
                            {
                                int m = i;
                                decimal now = pv.Planned(l, m);
                                decimal was = before is null ? 0 : plan.Planned(before, m);
                                PCalc calc = pv.Calc(l, m);
                                bool changed = m >= plan.Current && now != was;
                                string[] marks = m < plan.Current ? [] : [.. calc.MarksAt(m)];
                                string label = $"{l.Name}, {PFormat.MonthLong(m)}: {PFormat.Money(now)}" +
                                               (changed ? $", was {PFormat.Money(was)}" : "") +
                                               (marks.Length > 0 ? $". Shaped by: {string.Join(", ", calc.Steps.Select(s => s.Layer).Distinct())}" : "");
                                <td class="pgrid__cell" data-month="@PFormat.State(plan, m)" data-changed="@(changed ? "true" : null)"
                                    data-selected="@(q.Line == l.Id && q.Month == m ? "true" : null)" title="@label">
                                    @if (CellLinks)
                                    {
                                        <a class="pgrid__amount" href="@(q.Line == l.Id && q.Month == m ? q.WithLine(null) : q.Cell(l.Id, m))" aria-label="@label">
                                            @Amount(now, was, changed)
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="pgrid__amount">@Amount(now, was, changed)</span>
                                    }
                                    @if (marks.Length > 0)
                                    {
                                        <span class="pgrid__marks" aria-hidden="true">
                                            @foreach (string mark in marks)
                                            {
                                                <span data-mark="@mark">@mark</span>
                                            }
                                        </span>
                                    }
                                </td>
                            }
                            <td class="pgrid__cell pgrid__total">@PFormat.Money(Enumerable.Range(0, 12).Sum(m => pv.Planned(l, m)))</td>
                        </tr>
                        @if (Below is not null && q.Line == l.Id)
                        {
                            <tr class="pgrid__editor"><td colspan="14"><div class="pgrid__editor-body">@Below(l)</div></td></tr>
                        }
                    }
                }
            }
        </tbody>
        <tfoot>
            <tr class="pgrid__net">
                <th scope="row" class="pgrid__name">Net</th>
                @for (int i = 0; i < 12; i++)
                {
                    int m = i;
                    decimal now = pv.Net(m);
                    decimal was = plan.Net(m);
                    <td class="pgrid__cell" data-month="@PFormat.State(plan, m)" data-changed="@(now != was ? "true" : null)">@Amount(now, was, now != was)</td>
                }
                <td class="pgrid__cell pgrid__total">@PFormat.Money(Enumerable.Range(0, 12).Sum(pv.Net))</td>
            </tr>
        </tfoot>
    </table>
</div>
<p class="pgrid-legend">
    <span><strong>Letters:</strong></span>
    <span><span class="pgrid-legend__mark" data-mark="D">D</span> dated change</span>
    <span><span class="pgrid-legend__mark" data-mark="Y">Y</span> yearly change</span>
    <span><span class="pgrid-legend__mark" data-mark="S">S</span> seasonal variation</span>
    <span><span class="pgrid-legend__mark" data-mark="C">C</span> conditional change</span>
    <span><span class="pgrid-legend__mark" data-mark="O">O</span> override</span>
    <span><s>R 900</s> R 950: a proposal changes it</span>
</p>

@code {
    [Parameter, EditorRequired] public PSheet Sheet { get; set; } = null!;

    /// <summary>Variant A: each cell opens an editor for that month.</summary>
    [Parameter] public bool CellLinks { get; set; }

    /// <summary>Variant B: each line name opens the line's panel.</summary>
    [Parameter] public bool LineLinks { get; set; }

    /// <summary>Shown in a row under the selected line.</summary>
    [Parameter] public RenderFragment<PLine>? Below { get; set; }

    /// <summary>Variant B: show the category pencils, but open the editor elsewhere.</summary>
    [Parameter] public bool CategoryPencils { get; set; }

    /// <summary>Shown in a row under a category being edited.</summary>
    [Parameter] public RenderFragment<PCategory>? CategoryBelow { get; set; }

    private RenderFragment CategoryEdit(PCategory c) => __builder =>
    {
        if (CategoryBelow is not null || CategoryPencils)
        {
            bool open = Sheet.Query.Edit == "cat:" + c.Id;
            <a class="pgrid__edit" href="@(open ? Sheet.Query.Closed.Href : Sheet.Query.Closed.Editing("cat:" + c.Id))" aria-expanded="@(open ? "true" : "false")"
               aria-label="@($"Edit {c.Name}, or add to it")" title="Rename, move, remove, or add to it">
                <MnlIcon Name="MnlIconName.Pencil" Size="MnlSize.Sm" />
            </a>
        }
    };

    private RenderFragment Totals(IEnumerable<PLine> lines) => __builder =>
    {
        List<PLine> list = [.. lines];
        for (int i = 0; i < 12; i++)
        {
            int m = i;
            <td class="pgrid__cell" data-month="@PFormat.State(Sheet.Plan, m)">@PFormat.Money(list.Sum(l => Sheet.Preview.Planned(l, m)))</td>
        }

        <td class="pgrid__cell pgrid__total">@PFormat.Money(list.Sum(l => Enumerable.Range(0, 12).Sum(m => Sheet.Preview.Planned(l, m))))</td>
    };

    private static RenderFragment Amount(decimal now, decimal was, bool changed) => __builder =>
    {
        if (changed)
        {
            <s>@PFormat.Money(was)</s>
            <span class="pgrid__new">@PFormat.Money(now)</span>
        }
        else
        {
            @PFormat.Money(now)
        }
    };
}
