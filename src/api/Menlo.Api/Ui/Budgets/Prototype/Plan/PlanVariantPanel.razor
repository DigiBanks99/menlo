@*
    PROTOTYPE (#658) variant B, "Line panel": the grid only shows. Clicking a line's name opens a panel beside
    it with everything about that line: its details, every layer as a list you can take items out of, one form
    to add a change, and the year month by month with the layers behind each amount.
*@
@{
    PQuery q = Sheet.Query;
    PLine? line = Sheet.Line;
    PCategory? cat = q.Edit?.StartsWith("cat:", StringComparison.Ordinal) == true
        ? Sheet.Plan.Categories.FirstOrDefault(c => "cat:" + c.Id == q.Edit) : null;
    bool open = line is not null || cat is not null;
}
<div class="bsplit" data-open="@(open ? "true" : "false")">
    <MnlStack Gap="MnlGap.Sm">
        <MnlText Size="MnlTextSize.Sm" Tone="MnlTextTone.Subtle">Click a line's name to open it. The pencil beside a category edits it or adds a line.</MnlText>
        <PlanGrid Sheet="Sheet" LineLinks="true" CategoryPencils="true" />
    </MnlStack>

    @if (open)
    {
        <aside class="bpanel" aria-label="@(line?.Name ?? cat!.Name)" data-testid="line-panel">
            <div class="bpanel__head">
                @if (line is not null)
                {
                    <MnlStack Gap="MnlGap.Xs">
                        <MnlEyebrow>@Sheet.Preview.Path(line.CategoryId) · @PFormat.Type(line.Type)</MnlEyebrow>
                        <MnlHeading Level="2">@line.Name</MnlHeading>
                    </MnlStack>
                }
                else
                {
                    <MnlHeading Level="2">@cat!.Name</MnlHeading>
                }
                <MnlButton Href="@q.Closed.Href" Variant="MnlButtonVariant.Ghost" Size="MnlSize.Sm" Icon="MnlIconName.X" aria-label="Close the panel" />
            </div>

            @if (cat is not null)
            {
                <PlanCategoryEditor Sheet="Sheet" Category="cat" Back="@q.Closed.Href" />
            }
            else if (line is not null)
            {
                PLine l = line;
                <MnlDisclosure Open="false">
                    <Summary>Details: who it's for and who pays</Summary>
                    <ChildContent>
                        <form method="post" action="/budgets/prototype/plan/act" class="bpanel__form">
                            <PlanHidden Sheet="Sheet" Op="line-save" Direct="true" />
                            <input type="hidden" name="line" value="@l.Id" />
                            <MnlFormField Label="Name" For="d-name"><MnlInput Name="name" Id="d-name" Value="@l.Name" /></MnlFormField>
                            <MnlFormField Label="Category" For="d-cat"><MnlSelect Name="category" Id="d-cat" Value="@l.CategoryId" Options="Sheet.CategoryOptions" /></MnlFormField>
                            <MnlFormField Label="Line type" For="d-type"><MnlSelect Name="type" Id="d-type" Value="@l.Type.ToString()" Options="PSheet.TypeOptions" /></MnlFormField>
                            <MnlFormField Label="Who it is for" For="d-who"><MnlSelect Name="who" Id="d-who" Value="@l.Beneficiary" Options="PSheet.WhoOptions" /></MnlFormField>
                            <MnlFormField Label="Member A pays (%)" For="d-share" Hint="Member B pays the rest"><MnlInput Name="shareA" Id="d-share" Type="number" Value="@l.ShareA.ToString()" min="0" max="100" /></MnlFormField>
                            @if (!l.Income)
                            {
                                <MnlFormField Label="Rental share (%)" For="d-rental"><MnlInput Name="rental" Id="d-rental" Type="number" Value="@l.RentalShare.ToString()" min="0" max="100" /></MnlFormField>
                            }
                            <MnlButton Type="MnlButtonType.Submit" Size="MnlSize.Sm" Variant="MnlButtonVariant.Secondary">Save details</MnlButton>
                        </form>
                    </ChildContent>
                </MnlDisclosure>

                <section class="bpanel__section" aria-labelledby="layers-title">
                    <MnlHeading Level="3" id="layers-title">What shapes the plan</MnlHeading>
                    @if (l.Type == ProtoLineType.Event)
                    {
                        @Layer("Event amounts", [.. l.Events.OrderBy(e => e.Key).Select(e => ($"{PFormat.Money(e.Value)} in {PFormat.MonthLong(e.Key)}", e.Key >= Sheet.Plan.Current ? Change("event", e.Key) : null))])
                    }
                    else
                    {
                        @Layer("Baseline and dated changes", [.. l.Dated.Select((d, i) => (d.From == 0 && i == 0 ? $"Baseline {PFormat.Money(d.Amount)} a month" : $"{PFormat.Money(d.Amount)} a month from {PFormat.MonthLong(d.From)}", i > 0 && d.From >= Sheet.Plan.Current ? Remove("dated", i) : null))])
                        @Layer("Yearly changes", [.. l.Yearly.Select((x, i) => ($"{PFormat.Change(x.Value, x.Kind)} every {PFormat.MonthLong(x.Month)}", Remove("yearly", i)))])
                        @Layer("Seasonal variations", [.. l.Seasonal.Select((x, i) => ($"{PFormat.Change(x.Value, x.Kind)} in {PFormat.Months(x.Months)}", Remove("seasonal", i)))])
                        @Layer("Conditional changes", [.. l.Conditional.Select((x, i) => ($"{PFormat.Change(x.Value, x.Kind)} once \"{Sheet.Plan.Triggers.FirstOrDefault(t => t.Id == x.TriggerId)?.Name}\" (expected {PFormat.Month(Sheet.Plan.Triggers.FirstOrDefault(t => t.Id == x.TriggerId)?.Expected ?? 0)})", Remove("conditional", i)))])
                        @Layer("Overrides", [.. l.Overrides.OrderBy(o => o.Key).Select(o => ($"{PFormat.Money(o.Value)} in {PFormat.MonthLong(o.Key)}, over {PFormat.Money(Sheet.Preview.Calc(l, o.Key).Calculated)}", o.Key >= Sheet.Plan.Current ? Change("clear-override", o.Key) : null))])
                    }
                </section>

                <section class="bpanel__section" aria-labelledby="add-title">
                    <MnlHeading Level="3" id="add-title">Add a change</MnlHeading>
                    <PlanChangeForm Sheet="Sheet" Line="l" />
                </section>

                <MnlDisclosure Open="false">
                    <Summary>Month by month</Summary>
                    <ChildContent>
                        <table class="bpanel__months">
                            <thead><tr><th scope="col">Month</th><th scope="col">Planned</th><th scope="col">From</th></tr></thead>
                            <tbody>
                                @for (int i = 0; i < 12; i++)
                                {
                                    int m = i;
                                    PCalc c = Sheet.Preview.Calc(l, m);
                                    <tr data-month="@PFormat.State(Sheet.Plan, m)">
                                        <th scope="row">@PFormat.Month(m)</th>
                                        <td>@PFormat.Money(Sheet.Preview.Planned(l, m))</td>
                                        <td>@(m < Sheet.Plan.Current ? "Frozen" : string.Join(", ", c.Steps.Select(s => s.Layer).Distinct()))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </ChildContent>
                </MnlDisclosure>

                <form method="post" action="/budgets/prototype/plan/act">
                    <PlanHidden Sheet="Sheet" Op="line-remove" Direct="true" Back="@q.Closed.Href" />
                    <input type="hidden" name="line" value="@l.Id" />
                    <MnlButton Type="MnlButtonType.Submit" Variant="MnlButtonVariant.Ghost" Size="MnlSize.Sm" Icon="MnlIconName.Trash">End this line from @PFormat.MonthLong(Sheet.Plan.Current)</MnlButton>
                </form>
            }
        </aside>
    }
</div>

@code {
    [Parameter, EditorRequired] public PSheet Sheet { get; set; } = null!;


    private RenderFragment Layer(string title, IReadOnlyList<(string Text, RenderFragment? Action)> items) => __builder =>
    {
        <div class="bpanel__layer">
            <span class="bpanel__layer-title">@title</span>
            @if (items.Count == 0)
            {
                <span class="bpanel__none">None</span>
            }
            else
            {
                <ul>
                    @foreach ((string text, RenderFragment? action) in items)
                    {
                        <li><span>@text</span>@action</li>
                    }
                </ul>
            }
        </div>
    };

    private RenderFragment Remove(string layer, int index) => __builder =>
    {
        <form method="post" action="/budgets/prototype/plan/act">
            <PlanHidden Sheet="Sheet" Op="remove-layer" />
            <input type="hidden" name="line" value="@Sheet.Query.Line" />
            <input type="hidden" name="layer" value="@layer" />
            <input type="hidden" name="index" value="@index" />
            <MnlButton Type="MnlButtonType.Submit" Variant="MnlButtonVariant.Ghost" Size="MnlSize.Sm" Icon="MnlIconName.X" aria-label="Take it out">Take out</MnlButton>
        </form>
    };

    private RenderFragment Change(string change, int month) => __builder =>
    {
        <form method="post" action="/budgets/prototype/plan/act">
            <PlanHidden Sheet="Sheet" Op="change" />
            <input type="hidden" name="line" value="@Sheet.Query.Line" />
            <input type="hidden" name="change" value="@change" />
            <input type="hidden" name="month" value="@month" />
            <input type="hidden" name="amount" value="0" />
            <MnlButton Type="MnlButtonType.Submit" Variant="MnlButtonVariant.Ghost" Size="MnlSize.Sm" Icon="MnlIconName.X" aria-label="Take it out">Take out</MnlButton>
        </form>
    };
}
