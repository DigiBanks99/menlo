#!/bin/sh
# Formats staged files before each commit, for people and every agent alike.
# Enabled by `git config core.hooksPath .githooks` (run by `pnpm install` at the repo root).
# See .github/hooks/README.md. Skip once with `git commit --no-verify`.

root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -n "$staged" ] || exit 0

unstaged="$(git diff --name-only)"

net_files=""
web_files=""
partial=""
nl='
'

old_ifs="$IFS"
IFS="$nl"
for file in $staged; do
    case "$file" in
        *.cs | *.csproj | *.vb) kind=net ;;
        src/ui/web/*.ts | src/ui/web/*.tsx | src/ui/web/*.js | src/ui/web/*.jsx | src/ui/web/*.mjs | \
        src/ui/web/*.json | src/ui/web/*.html | src/ui/web/*.css | src/ui/web/*.scss | src/ui/web/*.md) kind=web ;;
        *) continue ;;
    esac

    # Re-staging a partly staged file would also stage its unstaged hunks.
    if printf '%s\n' "$unstaged" | grep -Fqx -- "$file"; then
        partial="$partial  $file$nl"
        continue
    fi

    if [ "$kind" = net ]; then
        net_files="$net_files$file$nl"
    else
        web_files="$web_files${file#src/ui/web/}$nl"
    fi
done
IFS="$old_ifs"

if [ -n "$partial" ]; then
    echo "pre-commit: these files are only partly staged, so they can't be formatted safely:" >&2
    printf '%s' "$partial" >&2
    echo "Stage the whole file, or format it yourself and commit with --no-verify." >&2
    exit 1
fi

status=0

if [ -n "$net_files" ]; then
    echo "pre-commit: dotnet format on staged .NET files"
    # shellcheck disable=SC2086 # split on newlines only
    IFS="$nl"
    if ! dotnet format Menlo.slnx --no-restore --include $net_files; then
        echo "pre-commit: dotnet format failed" >&2
        status=1
    fi
    IFS="$old_ifs"
fi

if [ -n "$web_files" ]; then
    echo "pre-commit: nx format:write on staged web files"
    web_csv="$(printf '%s' "$web_files" | sed '/^$/d' | paste -sd, -)"
    if ! (cd src/ui/web && pnpm exec nx format:write --files="$web_csv"); then
        echo "pre-commit: nx format:write failed" >&2
        status=1
    fi
fi

[ "$status" -eq 0 ] || exit "$status"

# Re-stage what the formatters changed (only fully staged files reach this point).
IFS="$nl"
for file in $net_files; do
    git add -- "$file"
done
for file in $web_files; do
    git add -- "src/ui/web/$file"
done
IFS="$old_ifs"

exit 0
